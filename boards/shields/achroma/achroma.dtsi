#include <dt-bindings/zmk/matrix_transform.h>
#include <dt-bindings/led/led.h>
#include <zephyr/dt-bindings/pinctrl/nrf-pinctrl.h>

/ {
    chosen {
        zmk,underglow = &led_strip;
    };

    // Full-keyboard matrix: 10 columns (5 per half) x 4 rows.
    // Left half uses columns 0-4, right half uses columns 5-9 (col-offset set in right overlay).
    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <10>;
        rows = <4>;

        map = <
            RC(0,4) RC(0,1) RC(0,0) RC(0,2) RC(0,3)   RC(0,8) RC(0,7) RC(0,5) RC(0,6) RC(0,9)
            RC(1,4) RC(1,1) RC(1,0) RC(1,2) RC(1,3)   RC(1,8) RC(1,7) RC(1,5) RC(1,6) RC(1,9)
            RC(2,4) RC(2,1) RC(2,0) RC(2,2) RC(2,3)   RC(2,8) RC(2,7) RC(2,5) RC(2,6) RC(2,9)
                            RC(3,0) RC(3,2) RC(3,3)   RC(3,8) RC(3,7) RC(3,5)
        >;
    };

    physical_layout_split: physical_layout_0 {
        compatible = "zmk,physical-layout";
        display-name = "Achroma";

        kscan = <&kscan0>;
        transform = <&default_transform>;
    };
};

// LED data line: PCB net "RGB" -> nice!nano pad 1 -> P0.06, used as SPI3 MOSI.
// NOTE: on the right half this pin changes if the controller is mounted mirrored. Review before building it.
&pinctrl {
    spi3_default: spi3_default {
        group1 {
            psels = <NRF_PSEL(SPIM_MOSI, 0, 6)>;
        };
    };

    spi3_sleep: spi3_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_MOSI, 0, 6)>;
            low-power-enable;
        };
    };
};

&spi3 {
    compatible = "nordic,nrf-spim";
    status = "okay";
    pinctrl-0 = <&spi3_default>;
    pinctrl-1 = <&spi3_sleep>;
    pinctrl-names = "default", "sleep";

    led_strip: ws2812@0 {
        compatible = "worldsemi,ws2812-spi";
        reg = <0>;
        spi-max-frequency = <4000000>;
        chain-length = <18>;   // 18 LEDs per half on the PCB
        spi-one-frame = <0x70>;
        spi-zero-frame = <0x40>;
        color-mapping = <LED_COLOR_ID_GREEN LED_COLOR_ID_RED LED_COLOR_ID_BLUE>;
    };
};
