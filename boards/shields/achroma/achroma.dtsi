#include <dt-bindings/zmk/matrix_transform.h>

/ {
    // Full-keyboard matrix: 10 columns (5 per half) x 4 rows.
    // Left half uses columns 0-4, right half uses columns 5-9 (col-offset set in right overlay).
    //
    // Column order below is taken from the PCB (CHn switch -> colN net), listed left-to-right
    // as they sit physically on the LEFT half: col4, col1, col0, col2, col3.
    // The right half is the mirror image: col3, col2, col0, col1, col4 (+5 offset).
    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <10>;
        rows = <4>;

        map = <
            RC(0,4) RC(0,1) RC(0,0) RC(0,2) RC(0,3)   RC(0,8) RC(0,7) RC(0,5) RC(0,6) RC(0,9)
            RC(1,4) RC(1,1) RC(1,0) RC(1,2) RC(1,3)   RC(1,8) RC(1,7) RC(1,5) RC(1,6) RC(1,9)
            RC(2,4) RC(2,1) RC(2,0) RC(2,2) RC(2,3)   RC(2,8) RC(2,7) RC(2,5) RC(2,6) RC(2,9)
                            RC(3,0) RC(3,2) RC(3,3)   RC(3,8) RC(3,7) RC(3,5)
        >;
    };

    physical_layout_split: physical_layout_0 {
        compatible = "zmk,physical-layout";
        display-name = "Achroma";

        kscan = <&kscan0>;
        transform = <&default_transform>;
    };
};
